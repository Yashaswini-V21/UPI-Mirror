# ════════════════════════════════════════════════════════════════════════════════
# Kira-AI Environment Variables
# ════════════════════════════════════════════════════════════════════════════════
#
# Setup Instructions:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in values:  edit .env with your API keys
#   3. NEVER commit:    .env is in .gitignore (gitignored for security)
#   4. Run:             uvicorn api.main:app --reload --port 8000
#
# Python 3.11+ required. All times in UTC.
#
# ════════════════════════════════════════════════════════════════════════════════

# ── Core API / Authentication ────────────────────────────────────────────────────

KIRA_AI_API_KEY=                # REQUIRED · FastAPI Bearer token for /coach, /upload, etc.
                                # Generate securely: python -c "import secrets; print(secrets.token_hex(32))"
                                # Minimum 32 characters enforced at startup.
                                # Share with frontend via a secure channel (never commit to repo).

ALLOWED_ORIGINS=http://localhost:5173,https://kira-ai.vercel.app
                                # OPTIONAL · CORS allowed origins, comma-separated
                                # Default if not set: https://yourdomain.example.com
                                # Development: http://localhost:5173 (Vite dev server)
                                # Production: https://kira-ai.vercel.app (Vercel frontend)

# ── Google Gemini AI (Required for Coach) ────────────────────────────────────────

GEMINI_API_KEY=                 # REQUIRED · Google Generative AI API key for narrative generation
                                # Free tier: 1M tokens/day (plenty for small deployments)
                                # Get it: https://aistudio.google.com/app/apikey
                                # No credit card required for free tier
                                # Model: gemini-1.5-flash (fast, cheap, <400 token output)

# ── GitLab Integration (Required for Rapid Agent Track) ───────────────────────────

GITLAB_TOKEN=                   # REQUIRED · GitLab personal access token for issue creation
                                # Get it: https://gitlab.com → Settings → Access Tokens
                                # Scopes: api (read/write issues and snippets)
                                # Permissions: Create issues, add snippets, add comments
                                # Token format: glpat-XXXXXXXXXXXXXXXXXXXXX

GITLAB_PROJECT_ID=              # REQUIRED · Numeric GitLab project ID for alerts/audit log
                                # Find it: https://gitlab.com/YOUR_USERNAME/YOUR_PROJECT → Settings → General
                                # Example: 12345678 (integer, not string)

GITLAB_API_URL=https://gitlab.com/api/v4
                                # OPTIONAL · GitLab API base URL (for self-hosted or enterprise)
                                # Default: https://gitlab.com/api/v4 (public GitLab)
                                # Self-hosted: https://gitlab.mycompany.com/api/v4

# ── Email Integration (Optional — Resend) ────────────────────────────────────────

RESEND_API_KEY=                 # OPTIONAL · Resend email service API key
                                # Free tier: 100 emails/day, no credit card
                                # Get it: https://resend.com → API Keys
                                # Use case: Send broke_date_warning when days_left <= 7
                                # If not set: Email notifications disabled (graceful degrade)

FROM_EMAIL=onboarding@resend.dev
                                # OPTIONAL · Sender email address for Resend
                                # Default: onboarding@resend.dev (Resend sandbox, works immediately)
                                # Production: Use your verified domain (requires DNS setup)
                                # Example: noreply@kira-ai.com (after domain verification)

TO_EMAIL=                       # OPTIONAL · Recipient email for coach alerts
                                # Example: your-email@gmail.com
                                # If not set: Email integration disabled

# ── WhatsApp Integration (Optional — Twilio) ─────────────────────────────────────

TWILIO_ACCOUNT_SID=             # OPTIONAL · Twilio account ID for WhatsApp via API
                                # Free sandbox: https://www.twilio.com/console/sms/whatsapp
                                # Mode A (wa.me links): Always available, no setup needed
                                # Mode B (Twilio): Optional, requires ACCOUNT_SID + AUTH_TOKEN
                                # Format: ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

TWILIO_AUTH_TOKEN=              # OPTIONAL · Twilio authentication token
                                # Get it: https://www.twilio.com/console → Settings → Auth Token
                                # Sandbox: Free 100 messages/day during testing

TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
                                # OPTIONAL · Twilio WhatsApp sender number (sandbox or production)
                                # Sandbox default: +14155238886 (Twilio's free sandbox number)
                                # Production: Upgrade account and use your own number
                                # Format: whatsapp:+CCXXXXXXXXXX

TWILIO_WHATSAPP_TO=             # OPTIONAL · Default recipient WhatsApp number
                                # Example: +919876543210 (E.164 format)
                                # If not set: Use /coach?whatsapp_to=XXX query param instead

# ── Session & Storage ────────────────────────────────────────────────────────────

COACH_MEMORY_DIR=./.coach_memory
                                # OPTIONAL · Directory for storing coach session memory
                                # Default: ./.coach_memory (relative to app root)
                                # Used for: Scenario history, feedback logs, audit trail
                                # Auto-created if doesn't exist

# ── Feature Flags ────────────────────────────────────────────────────────────────

ENABLE_GITLAB=true              # OPTIONAL · Enable GitLab integration for alerts/audit
                                # Set to: true/false (string boolean)
                                # If GITLAB_TOKEN or GITLAB_PROJECT_ID missing: Disabled automatically

ENABLE_EMAIL=false              # OPTIONAL · Enable email notifications (Resend)
                                # Set to: true/false
                                # If RESEND_API_KEY or TO_EMAIL missing: Disabled automatically

ENABLE_WHATSAPP=false           # OPTIONAL · Enable WhatsApp messages (Twilio or wa.me links)
                                # Set to: true/false
                                # Mode A (wa.me): Always available if ENABLE_WHATSAPP=true
                                # Mode B (Twilio): Available if TWILIO_ACCOUNT_SID set

# ── Deployment ───────────────────────────────────────────────────────────────────

ENVIRONMENT=development         # OPTIONAL · Deployment environment
                                # Values: development, staging, production
                                # Used for: Logging verbosity, error messages, feature gates

RAILWAY_DEPLOY_WEBHOOK=         # OPTIONAL · Railway deployment webhook (CI/CD)
                                # Get it: Railway dashboard → Project → Settings → Webhooks
                                # Used in: .gitlab-ci.yml for auto-deploy on main branch

RAILWAY_URL=                    # OPTIONAL · Railway production URL for monitoring
                                # Example: https://kira-ai-prod-xxx.up.railway.app
                                # Used in: GitLab CI environment link

# ════════════════════════════════════════════════════════════════════════════════
# Quick Start Checklist
# ════════════════════════════════════════════════════════════════════════════════
#
# ✓ REQUIRED (must fill in before running):
#   [ ] KIRA_AI_API_KEY       — Generate with: python -c "import secrets; print(secrets.token_hex(32))"
#   [ ] GEMINI_API_KEY        — Get from: https://aistudio.google.com/app/apikey
#   [ ] GITLAB_TOKEN          — Get from: https://gitlab.com → Settings → Access Tokens (api scope)
#   [ ] GITLAB_PROJECT_ID     — Find at: https://gitlab.com/YOUR_PROJECT → Settings → General
#
# ○ OPTIONAL (for features, can skip):
#   [ ] RESEND_API_KEY        — For email alerts (free 100/day)
#   [ ] TO_EMAIL              — Your email address
#   [ ] TWILIO_ACCOUNT_SID    — For WhatsApp via Twilio (sandbox free)
#   [ ] TWILIO_AUTH_TOKEN     — Twilio auth token
#
# ○ DEFAULTS (already filled in, customize as needed):
#   [ ] ALLOWED_ORIGINS       — Dev: localhost:5173, Prod: kira-ai.vercel.app
#   [ ] FROM_EMAIL            — onboarding@resend.dev (works immediately)
#   [ ] COACH_MEMORY_DIR      — ./.coach_memory (auto-created)
#
# ════════════════════════════════════════════════════════════════════════════════