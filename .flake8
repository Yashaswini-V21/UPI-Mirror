[flake8]
# Flake8 configuration for Kira-AI

# Line length
max-line-length = 120

# Ignore certain error codes
ignore = 
    E203,    # whitespace before ':'
    E501,    # line too long (handled by black)
    W503,    # line break before binary operator
    W504,    # line break after binary operator
    F841,    # local variable assigned but never used
    E701,    # multiple statements on one line (colon)

# Exclude paths
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    .pytest_cache,
    .coverage,
    htmlcov,
    .mypy_cache,
    node_modules,
    dist,
    build,
    *.egg-info

# Complexity
max-complexity = 12

# Per-file ignores
per-file-ignores =
    __init__.py:F401,F403
    tests/*:F401,F403,F811
    src/narrative.py:F401
