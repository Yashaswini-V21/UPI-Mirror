[flake8]
# Flake8 configuration for Kira-AI

# Line length
max-line-length = 120

# Ignore certain error codes
ignore = 
    E203,
    E501,
    W503,
    W504,
    F841,
    E701

# Exclude paths
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    .pytest_cache,
    .coverage,
    htmlcov,
    .mypy_cache,
    node_modules,
    dist,
    build,
    *.egg-info

# Complexity
max-complexity = 12

# Per-file ignores
per-file-ignores =
    __init__.py:F401,F403
    tests/*:F401,F403,F811
    core_logic/narrative.py:F401
